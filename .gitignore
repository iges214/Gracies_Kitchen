# ==============================================================================
# Git Ignore for Chef.sol (ASP.NET Core 8 + React/Vite)
# ==============================================================================

# User-specific files & Visual Studio
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
.idea/
.vscode/*
!.vscode/extensions.json

# Build and compilation outputs
[Bb]in/
[Oo]bj/
[Aa]pp_data/
dist/
dist-ssr/
build/

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets files (NEVER COMMIT SECRETS)
.env
.env.*
*.env
!.env.example
!*.env.example
secrets.json
appsettings*.local.json
appsettings.Production.json

# Local SQL Server database files
*.mdf
*.ldf

# Logs
logs/
*.log

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Docker local overrides
docker-compose.override.yml
