# ==============================================================================
# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)
# ==============================================================================
# In production, inject these variables via your cloud host / container environment.
# In local .NET development, prefer using .NET User Secrets:
#   dotnet user-secrets set "Jwt:Key" "your-secret-key" --project Chef.api
#   dotnet user-secrets set "InitialAdmin:Password" "your-admin-password" --project Chef.api
# ==============================================================================

# Database Connection String
ConnectionStrings__DefaultConnection=Server=localhost;Database=GraciesKitchenDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;

# JWT Signing Secret (Minimum 256 bits / 32 characters)
Jwt__Key=YOUR_STRONG_256_BIT_SECRET_KEY_HERE_MIN_32_CHARACTERS
Jwt__Issuer=GraciesKitchenApi
Jwt__Audience=GraciesKitchenClient

# Initial Admin Bootstrap (Optional; only seeded if password is provided)
InitialAdmin__Email=admin@gracieskitchen.com
InitialAdmin__Username=admin
InitialAdmin__FullName=Chef Gracie Admin
InitialAdmin__Password=YOUR_LOCAL_ADMIN_DEVELOPMENT_PASSWORD

# SMTP Configuration (Optional)
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__SenderEmail=orders@gracieskitchen.com
Smtp__SenderName=Gracie's Kitchen Dispatch
Smtp__EnableSsl=true
